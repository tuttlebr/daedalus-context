{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "auth", "service"],
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^(?:[^/\\s]+/\\S+)?$",
          "description": "OpenCode provider/model ID, or empty to use the existing Secret's model key."
        }
      }
    },
    "server": {
      "type": "object",
      "required": ["readOnly", "noHelm", "enableExec", "enableKubectl", "enableAgentWrite"],
      "properties": {
        "readOnly": {"type": "boolean"},
        "noHelm": {"type": "boolean"},
        "enableExec": {"type": "boolean"},
        "enableKubectl": {"type": "boolean"},
        "enableAgentWrite": {"type": "boolean"}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "service": {
      "type": "object",
      "required": ["port", "external"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
