{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "partOf", "releases", "profiles", "failurePolicy"],
  "properties": {
    "apiVersion": { "const": "daedalus.context/v1" },
    "kind": { "const": "Topology" },
    "partOf": { "const": "daedalus-context" },
    "releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milvus", "retriever", "nv-ingest", "pdf-server", "url-ingest", "k8s-mcp", "unifi-mcp"],
      "properties": {
        "milvus": { "$ref": "#/definitions/release" },
        "retriever": { "$ref": "#/definitions/release" },
        "nv-ingest": { "$ref": "#/definitions/release" },
        "pdf-server": { "$ref": "#/definitions/release" },
        "url-ingest": { "$ref": "#/definitions/release" },
        "k8s-mcp": { "$ref": "#/definitions/release" },
        "unifi-mcp": { "$ref": "#/definitions/release" }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string" }
      }
    },
    "failurePolicy": {
      "type": "object",
      "required": ["coreChatRequiresContext", "reranker", "ingestionFailureAffectsExistingSearch", "optionalToolFailureAffectsCoreChat"],
      "properties": {
        "coreChatRequiresContext": { "type": "boolean" },
        "reranker": { "enum": ["fail-open", "required"] },
        "ingestionFailureAffectsExistingSearch": { "type": "boolean" },
        "optionalToolFailureAffectsCoreChat": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "tier", "namespace", "requiredFor", "services"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["online", "ingestion", "tools"] },
        "namespace": { "type": "string", "minLength": 1 },
        "requiredFor": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "services": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/service" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "port", "protocol"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["http", "tcp"] },
        "optional": { "type": "boolean" },
        "healthPath": { "type": "string", "pattern": "^/" },
        "livePath": { "type": "string", "pattern": "^/" },
        "readyPath": { "type": "string", "pattern": "^/" },
        "dependencyPath": { "type": "string", "pattern": "^/" },
        "mcpPath": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
