{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "profile", "production", "ragReadinessMode", "requiredCollections", "namespaceMode", "acceptance"],
  "properties": {
    "apiVersion": { "const": "daedalus.context/v1" },
    "kind": { "const": "Environment" },
    "name": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "production": { "type": "boolean" },
    "ragReadinessMode": { "enum": ["disabled", "degraded", "required"] },
    "requiredCollections": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "namespaceMode": { "enum": ["shared", "single-development"] },
    "storage": { "type": "object" },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "haPhaseBlocked"],
      "properties": {
        "status": { "enum": ["development-only", "pending-owner-approval", "approved"] },
        "operatingMode": { "enum": ["shared-production", "personal-single-user"] },
        "haRequired": { "type": "boolean" },
        "haPhaseBlocked": { "type": "boolean" },
        "requiredDecisions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptedRisks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "nodeLoss": { "type": "object" },
        "coordinatorFailover": { "type": "object" },
        "redisFailover": { "type": "object" },
        "freshness": { "type": "object" },
        "statefulRecovery": { "type": "object" }
      }
    }
  }
}
