{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "schemaVersion", "collections"],
  "properties": {
    "apiVersion": { "const": "daedalus.context/v1" },
    "kind": { "const": "CollectionContract" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "sources", "schedule", "freshnessMaximumAgeHours", "chunkSize", "chunkOverlap", "minimumRecords"],
        "properties": {
          "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["url", "pdf"] }
          },
          "schedule": { "type": "string", "minLength": 9 },
          "freshnessMaximumAgeHours": { "type": "integer", "minimum": 1 },
          "chunkSize": { "type": "integer", "minimum": 1 },
          "chunkOverlap": { "type": "integer", "minimum": 0 },
          "minimumRecords": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
