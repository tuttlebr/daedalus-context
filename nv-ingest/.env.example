# NV-Ingest 26.3.0 deployment settings for the daedalus-context RAG stack.
# Copy this file to .env and keep real credentials out of version control.
# deploy.sh loads ../.env first, then this file; explicit caller values win.
# See DEPLOYMENT.md for rollout, readiness, migration, and rollback guidance.

# Release and rollout controls.
NAMESPACE=nv-ingest
RELEASE_NAME=nv-ingest
NV_INGEST_CHART_URL=https://helm.ngc.nvidia.com/nvidia/nemo-microservices/charts/nv-ingest-26.3.0.tgz
NV_INGEST_IMAGE_REPOSITORY=nvcr.io/nvidia/nemo-microservices/nv-ingest
NV_INGEST_IMAGE_TAG=26.3.0
NV_INGEST_REPLICA_COUNT=3
# ClusterIP is the recommended profile for in-cluster RAG clients. A nodePort
# is valid only with NodePort or LoadBalancer.
NV_INGEST_SERVICE_TYPE=ClusterIP
NV_INGEST_NODE_PORT=
HELM_TIMEOUT=20m
DRY_RUN=false

# Routine rollouts stop before mutation when a URL-ingest Job or run-lock is
# active, because replacing an API pod can orphan its in-flight Ray job.
URL_INGEST_NAMESPACE=milvus
ALLOW_DEPLOY_DURING_INGEST=false

# Existing unmarked destination Secrets are refused. Set this only for a
# deliberate one-time takeover after verifying the Secret names and owners.
ADOPT_EXISTING_SECRETS=false

# Credentials. NGC_API_KEY is required for the pinned NGC chart and images.
# Prefer the authoritative MinIO source Secret used by the root stack. The
# deploy reads accesskey and secretkey from one Secret snapshot, then creates
# an externally managed destination Secret referenced by the Deployment.
NGC_API_KEY=
MINIO_SOURCE_SECRET_NAMESPACE=milvus
MINIO_SOURCE_SECRET_NAME=milvus-minio-credentials
MINIO_CREDENTIAL_SECRET_NAME=nv-ingest-object-store
# Direct MinIO values are a fallback when no source Secret is configured.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Shared retrieval services and the document artifact bucket.
MILVUS_ENDPOINT=http://milvus.milvus.svc.cluster.local:19530
MINIO_INTERNAL_ADDRESS=http://milvus-minio.milvus.svc.cluster.local:9000
MINIO_PUBLIC_ADDRESS=http://milvus-minio.milvus.svc.cluster.local:9000
MINIO_BUCKET=nv-ingest
# Required when NV_INGEST_REPLICA_COUNT is greater than one. Use a dedicated,
# durable prefix supported by the pinned NV-Ingest chart/runtime.
IMAGE_STORAGE_URI=s3://daedalus-documents/nv-ingest/images/

# Keep this empty for authenticated external NVCF endpoints. Set ALL only when
# every configured component exposes NV-Ingest-compatible readiness JSON
# without additional authentication; otherwise the pipeline probe plus the
# authenticated ingestion preflight are the authoritative health checks.
COMPONENTS_TO_READY_CHECK=

# The local vLLM chart exposes a NIM-compatible /v1/embeddings API through its
# default compatibility sidecar. Override both values together for another
# embedding provider.
EMBEDDING_NIM_ENDPOINT=http://nemotron-retriever-embedder.daedalus-retriever.svc.cluster.local:8000/v1
EMBEDDING_NIM_MODEL_NAME=nvidia/llama-nemotron-embed-vl-1b-v2
INGEST_DISABLE_DYNAMIC_SCALING=true
INGEST_DYNAMIC_MEMORY_THRESHOLD=0.8
INGEST_EDGE_BUFFER_SIZE=64
INGEST_LOG_LEVEL=DEFAULT
MAX_INGEST_PROCESS_WORKERS=32
MESSAGE_CLIENT_HOST=nv-ingest-redis-master
MESSAGE_CLIENT_PORT=6379
MESSAGE_CLIENT_TYPE=redis
NEMOTRON_PARSE_HTTP_ENDPOINT=
NEMOTRON_PARSE_INFER_PROTOCOL=http
NEMOTRON_PARSE_MODEL_NAME=nvidia/nemotron-parse
NV_INGEST_MAX_UTIL=32
# Optional comma-separated scheduler pin, for example daedalus-02,daedalus-03.
NV_INGEST_NODE_HOSTNAMES=
OCR_GRPC_ENDPOINT=
OCR_HTTP_ENDPOINT=
OCR_INFER_PROTOCOL=http
OCR_MODEL_NAME=scene_text_ensemble
OMP_NUM_THREADS=1
VLM_CAPTION_ENDPOINT=
VLM_CAPTION_MODEL_NAME=nvidia/NVIDIA-Nemotron-Nano-12B-v2
YOLOX_GRAPHIC_ELEMENTS_GRPC_ENDPOINT=
YOLOX_GRAPHIC_ELEMENTS_HTTP_ENDPOINT=
YOLOX_GRAPHIC_ELEMENTS_INFER_PROTOCOL=http
YOLOX_GRPC_ENDPOINT=
YOLOX_HTTP_ENDPOINT=
YOLOX_INFER_PROTOCOL=http
YOLOX_PAGE_IMAGE_FORMAT=JPEG
YOLOX_TABLE_STRUCTURE_GRPC_ENDPOINT=
YOLOX_TABLE_STRUCTURE_HTTP_ENDPOINT=
YOLOX_TABLE_STRUCTURE_INFER_PROTOCOL=http
