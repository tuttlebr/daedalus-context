#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_DEPLOY_LOG:?}"

case "${1:-}" in
  show)
    echo "name: nv-ingest"
    echo "version: 26.3.0"
    ;;
  list)
    if [[ "${FAKE_RELEASE_EXISTS:-false}" == "true" ]]; then
      echo "nv-ingest"
    fi
    ;;
  get)
    [[ "${2:-}" == "manifest" ]]
    if [[ "${FAKE_MANIFEST_SECRET_FREE:-false}" == "true" ]]; then
      cat <<'EOF'
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nv-ingest
EOF
      exit 0
    fi
    cat <<'EOF'
---
apiVersion: v1
kind: Secret
metadata:
  name: ngc-secret  # name expected by NIMs
type: kubernetes.io/dockerconfigjson
---
apiVersion: v1
kind: Secret
metadata:
  name: ngc-api  # Name expected by NIMs
type: Opaque
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nv-ingest
EOF
    ;;
  upgrade)
    create_pull="unset"
    create_api="unset"
    has_post_renderer=false
    has_node_port=false
    has_ngc_password=false
    bucket="unset"
    atomic=false
    ngc_checksum="unset"
    object_checksum="unset"
    dry_run=false
    previous=""
    for argument in "$@"; do
      case "${argument}" in
        ngcImagePullSecret.create=*) create_pull="${argument#*=}" ;;
        ngcApiSecret.create=*) create_api="${argument#*=}" ;;
        ngcImagePullSecret.password=*|ngcApiSecret.password=*) has_ngc_password=true ;;
        service.nodePort=*) has_node_port=true ;;
        envVars.MINIO_BUCKET=*) bucket="${argument#*=}" ;;
        podAnnotations.daedalus\\.nvidia\\.com/ngc-secret-revision-checksum=*) ngc_checksum="${argument#*=}" ;;
        podAnnotations.daedalus\\.nvidia\\.com/object-store-secret-revision-checksum=*) object_checksum="${argument#*=}" ;;
        --atomic) atomic=true ;;
        --dry-run) dry_run=true ;;
      esac
      if [[ "${previous}" == "--post-renderer" ]]; then
        has_post_renderer=true
      fi
      previous="${argument}"
    done
    if [[ "${dry_run}" == "true" ]]; then
      operation=HELM_RENDER
    else
      operation=HELM_UPGRADE
    fi
    printf '%s pull=%s api=%s post=%s nodePort=%s password=%s bucket=%s atomic=%s ngc_checksum=%s object_checksum=%s\n' \
      "${operation}" \
      "${create_pull}" "${create_api}" "${has_post_renderer}" "${has_node_port}" \
      "${has_ngc_password}" "${bucket}" "${atomic}" "${ngc_checksum}" "${object_checksum}" \
      >>"${FAKE_DEPLOY_LOG}"
    if [[ "${dry_run}" == "false" && "${create_pull}" == "false" && \
          "${create_api}" == "false" && "${FAKE_FAIL_SECRET_FREE_FINAL:-false}" == "true" ]]; then
      echo "simulated Secret-free finalization failure" >&2
      exit 1
    fi
    ;;
  *)
    echo "Unexpected fake helm command: $*" >&2
    exit 1
    ;;
esac
