#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_DEPLOY_LOG:?}"
: "${FAKE_DEPLOY_STATE:?}"

namespace=""
args=("$@")
if [[ "${1:-}" == "-n" ]]; then
  namespace="${2:-}"
  args=("${@:3}")
fi

state_file() {
  printf '%s/%s' "${FAKE_DEPLOY_STATE}" "$1"
}

secret_exists() {
  case "$1" in
    ngc-secret|ngc-api) return 0 ;;
    nv-ingest-object-store) [[ -f "$(state_file object-created)" ]] ;;
    minio-source) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ "${args[0]:-}" == "get" && "${args[1]:-}" == "namespace" ]]; then
  printf 'namespace/%s' "${args[2]}"
  exit 0
fi

if [[ "${args[0]:-}" == "get" && "${args[1]:-}" == "jobs" ]]; then
  if [[ "${FAKE_ACTIVE_INGEST:-false}" == "true" ]]; then
    printf 'url-ingest-nvidia-test 1\n'
  fi
  exit 0
fi

if [[ "${args[0]:-}" == "get" && "${args[1]:-}" == "configmaps" ]]; then
  if [[ "${FAKE_ACTIVE_INGEST:-false}" == "true" ]]; then
    printf 'configmap/url-ingest-nvidia-run-lock\n'
  fi
  exit 0
fi

if [[ "${args[0]:-}" == "get" && "${args[1]:-}" == "deployment" ]]; then
  if [[ "${FAKE_RELEASE_EXISTS:-false}" == "true" ]]; then
    printf 'deployment.apps/%s\n' "${args[2]}"
  fi
  exit 0
fi

if [[ "${args[0]:-}" == "get" && "${args[1]:-}" == "secret" ]]; then
  secret_name="${args[2]:-}"
  if ! secret_exists "${secret_name}"; then
    for argument in "${args[@]}"; do
      [[ "${argument}" == "--ignore-not-found" ]] && exit 0
    done
    exit 1
  fi

  output=""
  for argument in "${args[@]}"; do
    if [[ "${argument}" == "name" ]]; then
      output="name"
    fi
    if [[ "${argument}" == go-template=* || "${argument}" == jsonpath=* ]]; then
      output="${argument}"
    fi
  done

  if [[ "${namespace}" == "milvus" && "${secret_name}" == "minio-source" ]]; then
    if [[ "${FAKE_SOURCE_INVALID:-false}" == "true" ]]; then
      printf '<no value>\n<no value>'
    elif [[ "${output}" == *accesskey* && "${output}" == *secretkey* ]]; then
      printf 'source-access\nsource-secret'
    elif [[ "${output}" == *accesskey* ]]; then
      printf 'source-access'
    elif [[ "${output}" == *secretkey* ]]; then
      printf 'source-secret'
    fi
    exit 0
  fi

  is_external=false
  [[ -f "$(state_file "${secret_name}-external")" ]] && is_external=true
  case "${output}" in
    name) printf 'secret/%s' "${secret_name}" ;;
    *resourceVersion*)
      case "${secret_name}" in
        ngc-secret)
          if [[ -n "${FAKE_NGC_SECRET_RESOURCE_VERSION:-}" ]]; then
            printf '%s' "${FAKE_NGC_SECRET_RESOURCE_VERSION}"
          elif [[ "${is_external}" == "true" ]]; then
            printf '201'
          else
            printf '101'
          fi
          ;;
        ngc-api)
          if [[ -n "${FAKE_NGC_API_RESOURCE_VERSION:-}" ]]; then
            printf '%s' "${FAKE_NGC_API_RESOURCE_VERSION}"
          elif [[ "${is_external}" == "true" ]]; then
            printf '202'
          else
            printf '102'
          fi
          ;;
        nv-ingest-object-store) printf '301' ;;
      esac
      ;;
    *meta\\.helm\\.sh/release-name*)
      [[ "${FAKE_NGC_UNMANAGED:-false}" != "true" && "${FAKE_HELM_OWNER_MALFORMED:-false}" != "true" && \
         "${is_external}" == "false" && "${secret_name}" == ngc-* ]] && printf 'nv-ingest'
      ;;
    *meta\\.helm\\.sh/release-namespace*)
      [[ "${FAKE_NGC_UNMANAGED:-false}" != "true" && "${FAKE_HELM_OWNER_MALFORMED:-false}" != "true" && \
         "${is_external}" == "false" && "${secret_name}" == ngc-* ]] && printf 'nv-ingest'
      ;;
    *app\\.kubernetes\\.io/managed-by*)
      if [[ "${is_external}" == "true" ]]; then
        printf 'daedalus-context'
      elif [[ "${FAKE_NGC_UNMANAGED:-false}" != "true" && "${secret_name}" == ngc-* ]]; then
        printf 'Helm'
      fi
      ;;
    *helm\\.sh/resource-policy*)
      [[ "${is_external}" == "true" ]] && printf 'keep'
      ;;
    *daedalus\\.nvidia\\.com/managed-by*)
      [[ "${is_external}" == "true" ]] && printf 'nv-ingest-deploy'
      ;;
  esac
  exit 0
fi

if [[ "${args[0]:-}" == "patch" && "${args[1]:-}" == "deployment" ]]; then
  printf 'MUTATE rollout-strategy %s\n' "${args[2]}" >>"${FAKE_DEPLOY_LOG}"
  exit 0
fi

if [[ "${args[0]:-}" == "create" && "${args[1]:-}" == "namespace" ]]; then
  printf 'apiVersion: v1\nkind: Namespace\nmetadata:\n  name: %s\n' "${args[2]}"
  printf 'MUTATE create-namespace\n' >>"${FAKE_DEPLOY_LOG}"
  exit 0
fi

if [[ "${args[0]:-}" == "create" && "${args[1]:-}" == "secret" ]]; then
  if [[ "${args[2]:-}" == "docker-registry" ]]; then
    secret_name="${args[3]}"
  else
    secret_name="${args[3]}"
  fi
  printf 'apiVersion: v1\nkind: Secret\nmetadata:\n  name: %s\n' "${secret_name}"
  printf 'MUTATE create-secret %s\n' "${secret_name}" >>"${FAKE_DEPLOY_LOG}"
  exit 0
fi

if [[ "${args[0]:-}" == "apply" ]]; then
  input="$(</dev/stdin)"
  if [[ "${input}" == *'name: nv-ingest-object-store'* ]]; then
    : >"$(state_file object-created)"
  fi
  printf 'MUTATE apply\n' >>"${FAKE_DEPLOY_LOG}"
  exit 0
fi

if [[ "${args[0]:-}" == "annotate" || "${args[0]:-}" == "label" ]]; then
  secret_name="${args[2]:-}"
  if [[ "${args[0]}" == "label" && " $* " == *' app.kubernetes.io/managed-by=daedalus-context '* ]]; then
    : >"$(state_file "${secret_name}-external")"
    printf 'EXTERNALIZED %s\n' "${secret_name}" >>"${FAKE_DEPLOY_LOG}"
  else
    printf 'MUTATE metadata %s\n' "${secret_name}" >>"${FAKE_DEPLOY_LOG}"
  fi
  exit 0
fi

if [[ "${args[0]:-}" == "get" && "${args[1]:-}" == "pods,svc" ]]; then
  echo "mock workload status"
  exit 0
fi

echo "Unexpected fake kubectl command: namespace=${namespace} args=${args[*]}" >&2
exit 1
