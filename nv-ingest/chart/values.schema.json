{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["nv-ingest", "podDisruptionBudget", "localParser"],
  "properties": {
    "localParser": {
      "type": "object",
      "required": ["service"],
      "properties": {
        "service": {
          "type": "object",
          "required": ["type", "nodePort", "externalTrafficPolicy"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort"]},
            "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767},
            "externalTrafficPolicy": {"type": "string", "enum": ["Cluster", "Local"]}
          }
        }
      }
    },
    "nv-ingest": {
      "type": "object",
      "required": ["replicaCount", "extraEnvVarsSecret", "envVars", "service"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "extraEnvVarsSecret": {"type": "string", "minLength": 1},
        "envVars": {"type": "object"},
        "service": {"type": "object"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer", "minimum": 1}
      }
    }
  }
}
