{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["nv-ingest", "podDisruptionBudget"],
  "properties": {
    "nv-ingest": {
      "type": "object",
      "required": ["replicaCount", "extraEnvVarsSecret", "envVars", "service"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "extraEnvVarsSecret": {"type": "string", "minLength": 1},
        "envVars": {"type": "object"},
        "service": {"type": "object"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer", "minimum": 1}
      }
    }
  }
}
