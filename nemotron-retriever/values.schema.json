{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespaceOverride", "image", "nimCompatibility", "reranker", "embedder"],
  "properties": {
    "namespaceOverride": {
      "type": "string"
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespaces", "ingressCIDRs", "ciliumNodePort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ingressCIDRs": {
          "type": "object",
          "required": ["reranker", "embedder"],
          "properties": {
            "reranker": { "$ref": "#/definitions/cidrList" },
            "embedder": { "$ref": "#/definitions/cidrList" }
          }
        },
        "ciliumNodePort": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "nimCompatibility": {
      "type": "object",
      "required": ["enabled", "port", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "requestTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "maxRequestBytes": { "type": "string", "minLength": 4 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    },
    "reranker": { "$ref": "#/definitions/modelServer" },
    "embedder": { "$ref": "#/definitions/modelServer" }
  },
  "definitions": {
    "cidrList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "modelServer": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount",
        "model",
        "servedModelName",
        "revision",
        "configSha256",
        "port",
        "maxModelLen",
        "service",
        "persistence"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "model": { "type": "string", "minLength": 1 },
        "servedModelName": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "configSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "maxModelLen": { "type": "integer", "minimum": 1 },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "service": {
          "type": "object",
          "required": [
            "type",
            "port",
            "annotations",
            "loadBalancerClass",
            "allocateLoadBalancerNodePorts",
            "loadBalancerSourceRanges"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "clusterIP": { "type": "string" },
            "nodePort": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "loadBalancerClass": { "type": "string" },
            "allocateLoadBalancerNodePorts": { "type": "boolean" },
            "loadBalancerSourceRanges": { "$ref": "#/definitions/cidrList" }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "multiReplicaSafe": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "size": { "type": "string" },
            "keep": { "type": "boolean" }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 1 }
          }
        },
        "topologySpread": {
          "type": "object",
          "required": ["enabled", "maxSkew", "topologyKey", "whenUnsatisfiable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSkew": { "type": "integer", "minimum": 1 },
            "topologyKey": { "type": "string", "minLength": 1 },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": ["DoNotSchedule", "ScheduleAnyway"]
            }
          }
        }
      }
    }
  }
}
