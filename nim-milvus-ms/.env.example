# Optional Milvus deployment overrides. Copy to an untracked .env; never
# commit real credentials. deploy.sh loads ../.env, then this directory's
# .env, then reapplies caller environment variables as the highest priority.

# Release identity. Pass these explicitly to destroy.sh/reset-etcd.sh because
# destructive scripts intentionally do not load .env files.
NAMESPACE=milvus
RELEASE_NAME=milvus

# Pinned active chart. The matching image tag v2.6.11 is in custom-values.yaml.
CHART=zilliztech/milvus
CHART_VERSION=5.0.14
HELM_TIMEOUT=15m
DRY_RUN=false
EXPOSE_NODEPORTS=false
ENABLE_MONITORING=false

# On a new release, install etcd and MinIO first, then roll out Milvus. Disable
# only when those dependencies are managed and made ready independently.
COLD_START_DEPENDENCY_BOOTSTRAP=true
# Distributed MinIO requires an integer >= 4.
MINIO_REPLICAS=4
# Bulk MinIO objects remain on NFS. The small, latency-sensitive etcd members
# explicitly use the dedicated non-default local NVMe class.
MINIO_STORAGE_CLASS=nfs-client
ETCD_STORAGE_CLASS=local-etcd
# Second bucket for NV-Ingest/Daedalus documents. milvus-bucket remains fixed
# for Milvus segments. Renaming this does not migrate existing objects.
MINIO_DOCUMENT_BUCKET=nv-ingest

# Bootstrap-only inputs used when the named Kubernetes Secrets do not exist.
# Prefer pre-provisioned Secrets. Existing Secrets are never overwritten from
# these values, and deploy output/Helm values never contains these credentials.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MILVUS_ROOT_PASSWORD=

# Secret keys must be accesskey/secretkey and password, respectively. These
# Secrets are external to Helm and survive deploy, rollback, reset, and destroy.
# Changing the root Secret does not call Milvus update_password; follow the
# coordinated API-plus-Secret rotation procedure in README.md.
MINIO_SECRET_NAME=milvus-minio-credentials
MILVUS_ROOT_SECRET_NAME=milvus-root-credentials
