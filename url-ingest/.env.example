# URL ingest deployment settings.
# The deploy script also loads ../.env before this file.

# Required on the first deployment. Later reconciles can reuse the existing
# namespace-local HF token.
HF_ACCESS_TOKEN=
MILVUS_USERNAME=root

# Direct k8s/deploy.sh namespace and service wiring. The workspace Makefile
# supplies these values during normal operations.
NAMESPACE=milvus
MILVUS_NAMESPACE=milvus
NV_INGEST_NAMESPACE=nv-ingest
MILVUS_SERVICE=milvus
MINIO_SERVICE=milvus-minio
NV_INGEST_SERVICE=nv-ingest

# Authoritative credentials are read from these Milvus namespace Secrets and
# mirrored into the url-ingest workload Secret. Do not duplicate values here.
# Local Compose cannot read Kubernetes Secrets; add MINIO_ACCESS_KEY,
# MINIO_SECRET_KEY, and MILVUS_PASSWORD only to the untracked local .env when
# using the Compose runner.
MINIO_SOURCE_SECRET_NAMESPACE=milvus
MINIO_SOURCE_SECRET_NAME=milvus-minio-credentials
MINIO_SOURCE_ACCESS_KEY=accesskey
MINIO_SOURCE_SECRET_KEY=secretkey
MILVUS_ROOT_SECRET_NAME=milvus-root-credentials
IMAGE_PULL_SECRET=nvcr-imagepullsecret
IMAGE_PULL_SECRET_SOURCE_NAMESPACE=default

# Shared service endpoints.
MILVUS_URI=http://milvus.milvus.svc.cluster.local:19530
MINIO_ENDPOINT=milvus-minio.milvus.svc.cluster.local:9000
MINIO_BUCKET=nv-ingest
NV_INGEST_MESSAGE_HOST=nv-ingest.nv-ingest.svc.cluster.local
NV_INGEST_MESSAGE_PORT=7670
NV_INGEST_VERSION=26.3.0
URL_INGEST_IMAGE=daedalus.ddns.me:5050/btuttle/url-ingest:0.1.0
URL_INGEST_RUNNER_IMAGE=daedalus.ddns.me:5050/btuttle/url-ingest-runner:0.1.0

# Optional seed source overrides. These paths are evaluated on the Kubernetes
# node that runs each seed pod.
URL_INGEST_SOURCE_HOST_PATH=/volume2/daedalus/datasets/daedalus-context/url-ingest
PDF_SOURCE_HOST_PATH=/volume2/daedalus/datasets/daedalus-context/pdf-server
URL_INGEST_SOURCE_NODE=daedalus-01
PRUNE_STAGED_DATA=true

# Bounded staging, dependency, manual-Job, and verification controls. The Job
# deadline is six hours; the operator wait allows ten additional minutes for
# Kubernetes to publish terminal state and diagnostics.
ROLLOUT_TIMEOUT=10m
READINESS_TIMEOUT_SECONDS=600
STAGE_URL_TIMEOUT_SECONDS=3600
STAGE_PDF_TIMEOUT_SECONDS=900
INGEST_JOB_DEADLINE_SECONDS=21600
INGEST_WAIT_TIMEOUT_SECONDS=22200
INGEST_POLL_SECONDS=10
COLLECTION_VERIFY_TIMEOUT_SECONDS=300
MANUAL_JOB_BACKOFF_LIMIT=1

# Manual NVIDIA runs use a deterministic path hash. Keep parallelism at one
# until NV-Ingest capacity has been measured; each shard has its own client
# worker pool.
NVIDIA_INGEST_SHARDS=8
MAX_PARALLEL_INGEST_SHARDS=1

# Manual Jobs receive these bounded NV-Ingest 26.3.0 compatibility controls.
# Scheduled Jobs use the same Python defaults when the variables are absent.
CLIENT_REQUEST_TIMEOUT_SECONDS=60
CLIENT_MAX_JOB_RETRIES=120
CLIENT_RETRY_DELAY_SECONDS=5

# Local Python/Compose runner defaults. Kubernetes URL/PDF file batches,
# CLIENT_BATCH_SIZE, and CLIENT_CONCURRENCY_LIMIT are collection-specific in
# k8s/cronjob-*.yaml; changing only this file does not override those manifests.
CHUNK_SIZE=1024
CHUNK_OVERLAP=64
EMBEDDING_DENSE_DIM=2048
TOKENIZER=meta-llama/Llama-3.2-1B
FILE_CHUNK_SIZE=64
URL_FILE_CHUNK_SIZE=64
PDF_FILE_CHUNK_SIZE=16
CLIENT_BATCH_SIZE=16
CLIENT_CONCURRENCY_LIMIT=16
SAVE_RESULTS_TO_DISK=true
RESULTS_BASE_PATH=/tmp/nv-ingest/results
INGEST_VERSION=v1
ALLOW_EMPTY_INPUTS=false
NEVER_DROP_COLLECTIONS=true
DROP_COLLECTIONS_BEFORE_INGEST=false
CONFIRM_DROP_COLLECTIONS=false
DO_NOT_TRACK=true
INGEST_LOG_LEVEL=INFO
