# Shared Daedalus context deployment settings. Read docs/deployment.md first.
# Copy to .env at the workspace root. All service deployments use the root
# Makefile and their service-owned chart; component-local .env files are not loaded.

# Select the reviewed environment and type the approved Kubernetes context
# literally. Never populate EXPECTED_CONTEXT from the active context.
ENVIRONMENT=production
EXPECTED_CONTEXT=
DAEDALUS_NAMESPACE=daedalus
# Adjacent chart owner for the Hindsight lifecycle targets. Its own .env holds
# Hindsight credentials; the root workflow never copies them into Helm values.
HINDSIGHT_ROOT=../daedalus-hindsight

# Build/publish your own images. The checked-in chart defaults describe the
# maintainer's deployment; that private registry is not a public image service.
IMAGE_REGISTRY=ghcr.io/your-github-user
DAEDALUS_CONTEXT_IMAGE_VERSION=0.1.0
# Runtime references are authoritative here; Compose aliases reuse them below.
K8S_MCP_IMAGE=${IMAGE_REGISTRY}/k8s-mcp-server:0.1.2
UNIFI_MCP_IMAGE=${IMAGE_REGISTRY}/unifi-network-mcp-server:0.2.1
PDF_SERVER_IMAGE=${IMAGE_REGISTRY}/pdf-server:${DAEDALUS_CONTEXT_IMAGE_VERSION}
URL_INGEST_IMAGE=${IMAGE_REGISTRY}/url-ingest:${DAEDALUS_CONTEXT_IMAGE_VERSION}
URL_INGEST_RUNNER_IMAGE=${IMAGE_REGISTRY}/url-ingest-runner:2.1.5
NV_INGEST_PARSER_IMAGE=${IMAGE_REGISTRY}/nemotron-parse:0.1.3
K8S_MCP_COMPOSE_IMAGE=${K8S_MCP_IMAGE}
UNIFI_MCP_COMPOSE_IMAGE=${UNIFI_MCP_IMAGE}
PDF_SERVER_COMPOSE_IMAGE=${PDF_SERVER_IMAGE}
URL_INGEST_COMPOSE_IMAGE=${URL_INGEST_IMAGE}
URL_INGEST_RUNNER_COMPOSE_IMAGE=${URL_INGEST_RUNNER_IMAGE}

# Optional site overlays (paths relative to the repository root). Root image,
# endpoint, storage, and operational flags passed with --set remain authoritative.
# Override placement/resources/CNI/GPU scheduler settings for your own cluster.
MILVUS_VALUES_FILE=
NV_INGEST_VALUES_FILE=
PDF_SERVER_VALUES_FILE=
URL_INGEST_VALUES_FILE=
UNIFI_MCP_VALUES_FILE=
# This overlay is specific to the maintainer's LAN and GPU cluster.
# Replace it with your reviewed site file for another deployment.
RETRIEVER_VALUES_FILE=nemotron-retriever/chart/values-daedalus.yaml
# Kubernetes exposes the authenticated MCP services to Codex and other
# out-of-cluster clients on these stable NodePorts. Bearer auth remains
# mandatory for every MCP request. Cilium drops NodePort traffic outside the
# configured local client network before it reaches either MCP pod.
K8S_MCP_NODE_PORT=30800
# Set read-only/no-helm to false for Kubernetes and Helm writes. The chart
# adds cluster-wide resource CRUD permissions (including Secrets for Helm).
K8S_MCP_READ_ONLY=true
K8S_MCP_NO_HELM=true
# These capabilities also require K8S_MCP_READ_ONLY=false.
K8S_MCP_ENABLE_EXEC=false
K8S_MCP_ENABLE_KUBECTL=false
K8S_MCP_ENABLE_AGENT_WRITE=false
# Optional reviewed chart overrides, e.g. the existing Daedalus model gateway:
# K8S_MCP_VALUES_FILE=k8s-multicluster-mcp/chart/values-daedalus.yaml
K8S_MCP_VALUES_FILE=
UNIFI_MCP_NODE_PORT=30081
MCP_EXTERNAL_CLIENT_CIDR=192.168.1.0/24
# Keep external MCP exposure disabled on new installations until internal checks pass.
MCP_EXTERNAL_ENABLED=false
# Keep recurring crawls suspended until the fresh corpus has been validated.
URL_INGEST_SUSPEND=true
URL_INGEST_GLOBAL_CAPACITY=1

# Shared ingestion settings. Provider endpoints come from the root Makefile;
# generate consumer endpoint settings with make render-agent-env.
MILVUS_DATABASE=default
NV_INGEST_MESSAGE_PORT=7670
NV_INGEST_VERSION=26.3.0
NV_INGEST_REPLICA_COUNT=2
# Required for replica counts above one; confirm URI support against the pinned
# NV-Ingest release before deployment.
IMAGE_STORAGE_URI=s3://daedalus-documents/nv-ingest/images/

# PDF and rendered Office extraction uses the local Nemotron Parse service.
LOCAL_DOCUMENT_PARSE_ENDPOINT=http://nv-ingest-parser.daedalus.svc.cluster.local:8000
# These compatibility fields satisfy upstream stage schemas. The root supplies
# local disabled paths for the replaced external engines. Document extraction
# uses the local parser and has no remote-model fallback.
OCR_INFER_PROTOCOL=http
OCR_MODEL_NAME=scene_text_ensemble
YOLOX_INFER_PROTOCOL=http
YOLOX_GRAPHIC_ELEMENTS_INFER_PROTOCOL=http
YOLOX_TABLE_STRUCTURE_INFER_PROTOCOL=http
VLM_CAPTION_MODEL_NAME=nvidia/NVIDIA-Nemotron-Nano-12B-v2
NEMOTRON_PARSE_INFER_PROTOCOL=http
NEMOTRON_PARSE_MODEL_NAME=nvidia/nemotron-parse

# Model contract is pinned in stack/rag-schema.yaml and the retriever chart.
# Updating it requires a coordinated model/data generation change.
EMBEDDING_NIM_MODEL_NAME=nvidia/Nemotron-3.5-Embed-1B-NVFP4

# Provider and consumer credentials. Keep real values in .env only and use a
# distinct token for each MCP provider.
K8S_MCP_AUTH_TOKEN=
UNIFI_MCP_AUTH_TOKEN=
KUBERNETES_MCP_TOKEN=
UNIFI_MCP_TOKEN=
K8S_MCP_AUTH_TOKEN_NEXT=
UNIFI_MCP_AUTH_TOKEN_NEXT=
NGC_API_KEY=
NVIDIA_API_KEY=
HF_ACCESS_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MILVUS_ROOT_PASSWORD=
MILVUS_USERNAME=root
# Document objects shared by NV-Ingest and daedalus-agent. Milvus keeps its
# internal segment objects in the separate milvus-bucket chart setting.
MINIO_BUCKET=nv-ingest

# MinIO stores bulk objects on shared storage; only small etcd claims use local-etcd.
MINIO_STORAGE_CLASS=nfs-client
ETCD_STORAGE_CLASS=local-etcd

# Production RAG health gate. Development profiles may intentionally leave
# this empty.
REQUIRED_COLLECTIONS="nvidia kubernetes vetpartner semianalysis mentalhealth"

# Fixed-controller production mode prevents callers from supplying a different
# base URL or API key. Restrict egress to the controller's exact CIDR.
UNIFI_BASE_URL=https://unifi.example/proxy/network/integration
UNIFI_CONTROLLER_CIDR=192.0.2.10/32
UNIFI_INSECURE_SKIP_VERIFY=false
UNIFI_CONTROLLER_CA_FILE=
UNIFI_CONTROLLER_HOSTNAME=
UNIFI_CONTROLLER_IP=
UNIFI_API_KEY=

# Optional seed source overrides. These paths are evaluated on the Kubernetes
# node that runs each seed pod.
PDF_SOURCE_HOST_PATH=/srv/daedalus-context/corpus
URL_INGEST_SOURCE_NODE=your-source-node
