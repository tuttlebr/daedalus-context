# Shared Daedalus context deployment settings.
# Copy to .env at the workspace root. Child deploy.sh scripts load this first,
# then load their own .env file if present.

# Select the reviewed environment and type the approved Kubernetes context
# literally. Never populate EXPECTED_CONTEXT from the active context.
ENVIRONMENT=production
EXPECTED_CONTEXT=
DAEDALUS_NAMESPACE=daedalus
# Adjacent chart owner for the Hindsight lifecycle targets. Its own .env holds
# Hindsight credentials; the root workflow never copies them into Helm values.
HINDSIGHT_ROOT=../daedalus-hindsight

# Versioned image specification used by make images-*.
DAEDALUS_CONTEXT_IMAGE_VERSION=0.1.0
# Kubernetes exposes the authenticated MCP services to Codex and other
# out-of-cluster clients on these stable NodePorts. Bearer auth remains
# mandatory for every MCP request. Cilium drops NodePort traffic outside the
# configured local client network before it reaches either MCP pod.
K8S_MCP_NODE_PORT=30800
UNIFI_MCP_NODE_PORT=30081
MCP_EXTERNAL_CLIENT_CIDR=192.168.1.0/24
# Keep external MCP exposure disabled until the in-cluster cutover passes.
MCP_EXTERNAL_ENABLED=false
# Keep recurring crawls suspended until the fresh corpus has been validated.
URL_INGEST_SUSPEND=true
URL_INGEST_GLOBAL_CAPACITY=1
MAX_PARALLEL_INGEST_SHARDS=1
K8S_MCP_COMPOSE_IMAGE=daedalus.ddns.me:5050/btuttle/k8s-mcp-server:${DAEDALUS_CONTEXT_IMAGE_VERSION}
UNIFI_MCP_COMPOSE_IMAGE=daedalus.ddns.me:5050/btuttle/unifi-network-mcp-server:0.2.0
PDF_SERVER_COMPOSE_IMAGE=daedalus.ddns.me:5050/btuttle/pdf-server:${DAEDALUS_CONTEXT_IMAGE_VERSION}
URL_INGEST_COMPOSE_IMAGE=daedalus.ddns.me:5050/btuttle/url-ingest:${DAEDALUS_CONTEXT_IMAGE_VERSION}
URL_INGEST_RUNNER_COMPOSE_IMAGE=daedalus.ddns.me:5050/btuttle/url-ingest-runner:${DAEDALUS_CONTEXT_IMAGE_VERSION}

# Shared cluster endpoints.
HINDSIGHT_API_URL=http://hindsight-api.daedalus.svc.cluster.local:8888
KUBERNETES_MCP_SERVER=http://k8s-mcp-server.daedalus.svc.cluster.local:8080/mcp
MILVUS_URI=http://milvus.daedalus.svc.cluster.local:19530
MILVUS_ENDPOINT=http://milvus.daedalus.svc.cluster.local:19530
MINIO_ENDPOINT=http://milvus-minio.daedalus.svc.cluster.local:9000
NV_INGEST_MESSAGE_HOST=nv-ingest.daedalus.svc.cluster.local
NV_INGEST_MESSAGE_PORT=7670
NV_INGEST_VERSION=26.3.0
NV_INGEST_REPLICA_COUNT=2
# Required for replica counts above one; confirm URI support against the pinned
# NV-Ingest release before deployment.
IMAGE_STORAGE_URI=s3://daedalus-documents/nv-ingest/images/
URL_INGEST_IMAGE=daedalus.ddns.me:5050/btuttle/url-ingest:${DAEDALUS_CONTEXT_IMAGE_VERSION}
URL_INGEST_RUNNER_IMAGE=daedalus.ddns.me:5050/btuttle/url-ingest-runner:${DAEDALUS_CONTEXT_IMAGE_VERSION}

# NV-Ingest document extraction dependencies. The shared chart does not deploy
# local OCR, layout, caption, or parser NIMs, so every endpoint is required and
# must resolve to an approved external service.
OCR_HTTP_ENDPOINT=
OCR_INFER_PROTOCOL=http
OCR_MODEL_NAME=scene_text_ensemble
YOLOX_HTTP_ENDPOINT=
YOLOX_INFER_PROTOCOL=http
YOLOX_GRAPHIC_ELEMENTS_HTTP_ENDPOINT=
YOLOX_GRAPHIC_ELEMENTS_INFER_PROTOCOL=http
YOLOX_TABLE_STRUCTURE_HTTP_ENDPOINT=
YOLOX_TABLE_STRUCTURE_INFER_PROTOCOL=http
VLM_CAPTION_ENDPOINT=
VLM_CAPTION_MODEL_NAME=nvidia/NVIDIA-Nemotron-Nano-12B-v2
NEMOTRON_PARSE_HTTP_ENDPOINT=
NEMOTRON_PARSE_INFER_PROTOCOL=http
NEMOTRON_PARSE_MODEL_NAME=nvidia/nemotron-parse

# Local Nemotron retrieval inference. NV-Ingest consumes the NIM-compatible
# endpoints. Daedalus uses the native vLLM /rerank request/response contract.
RETRIEVER_NAMESPACE=daedalus
EMBEDDING_NIM_ENDPOINT=http://nemotron-retriever-embedder.daedalus.svc.cluster.local:8000/v1
EMBEDDING_NIM_MODEL_NAME=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_BASE_URL=http://nemotron-retriever-embedder.daedalus.svc.cluster.local:8000/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DENSE_DIM=2048
RERANKER_BASE_URL=http://nemotron-retriever-reranker.daedalus.svc.cluster.local:8000/rerank
DAEDALUS_RERANKER_ENDPOINT=http://nemotron-retriever-reranker.daedalus.svc.cluster.local:8000/rerank
NIM_RERANKER_ENDPOINT=http://nemotron-retriever-reranker.daedalus.svc.cluster.local:8000/v1/ranking
RERANKER_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# Current Daedalus clients require non-empty API-key fields. The in-cluster
# adapters do not authenticate this placeholder; network access controls are
# the security boundary unless API authentication is added separately.
EMBEDDING_API_KEY=local-vllm-no-auth
RERANKER_API_KEY=local-vllm-no-auth

# Provider and consumer credentials. Keep real values in .env only and use a
# distinct token for each MCP provider.
K8S_MCP_AUTH_TOKEN=
UNIFI_MCP_AUTH_TOKEN=
KUBERNETES_MCP_TOKEN=
UNIFI_MCP_TOKEN=
K8S_MCP_AUTH_TOKEN_NEXT=
UNIFI_MCP_AUTH_TOKEN_NEXT=
NGC_API_KEY=
NVIDIA_API_KEY=
HF_ACCESS_TOKEN=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MILVUS_ROOT_PASSWORD=
MILVUS_USERNAME=root
# Document objects shared by NV-Ingest and daedalus-agent. Milvus keeps its
# internal segment objects in the separate milvus-bucket chart setting.
MINIO_BUCKET=nv-ingest

# MinIO stores bulk objects on shared storage; only small etcd claims use local-etcd.
MINIO_STORAGE_CLASS=nfs-client
ETCD_STORAGE_CLASS=local-etcd

# Production RAG health gate. Development profiles may intentionally leave
# this empty.
REQUIRED_COLLECTIONS="nvidia kubernetes vetpartner semianalysis mentalhealth"

# Versioned release images. Deployment rejects unversioned tags such as latest.
K8S_MCP_IMAGE=daedalus.ddns.me:5050/btuttle/k8s-mcp-server:${DAEDALUS_CONTEXT_IMAGE_VERSION}
UNIFI_MCP_IMAGE=daedalus.ddns.me:5050/btuttle/unifi-network-mcp-server:0.2.0
PDF_SERVER_IMAGE=daedalus.ddns.me:5050/btuttle/pdf-server:${DAEDALUS_CONTEXT_IMAGE_VERSION}

# Fixed-controller production mode prevents callers from supplying a different
# base URL or API key. Restrict egress to the controller's exact CIDR.
UNIFI_BASE_URL=https://unifi.example/proxy/network/integration
UNIFI_CONTROLLER_CIDR=192.0.2.10/32
UNIFI_INSECURE_SKIP_VERIFY=false
UNIFI_API_KEY=

# Optional seed source overrides. These paths are evaluated on the Kubernetes
# node that runs each seed pod.
URL_INGEST_SOURCE_HOST_PATH=/volume2/daedalus/datasets/daedalus-context/url-ingest
PDF_SOURCE_HOST_PATH=/volume2/daedalus/datasets/daedalus-context/pdf-server
URL_INGEST_SOURCE_NODE=daedalus-01
